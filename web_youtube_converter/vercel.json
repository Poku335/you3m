{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "functions": {
    "api/video-info.js": {
      "maxDuration": 30
    },
    "api/convert.js": {
      "maxDuration": 300
    },
    "api/download/[id].js": {
      "maxDuration": 60
    }
  }
}