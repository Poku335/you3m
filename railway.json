{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python manage.py migrate --settings=youtube_converter.settings_production && gunicorn youtube_converter.wsgi:application --bind 0.0.0.0:$PORT --env DJANGO_SETTINGS_MODULE=youtube_converter.settings_production",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}